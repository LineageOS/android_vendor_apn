genrule {
    name: "apns-conf",
    out: ["apns-conf.xml"],
    srcs: [
        ":upstream_apns_conf",
        ":local_apns_conf",
        "merge-apns-conf.yaml",
        ":apns-conf-schema",
    ],
    tools: [
        "make-apns",
        "xmllint",
    ],
    cmd: "$(location make-apns) --source $(location :upstream_apns_conf) " +
        "--config $(location merge-apns-conf.yaml) " +
        "--schema $(location :apns-conf-schema) --xmllint $(location xmllint) " +
        "$(locations :local_apns_conf) > $(out)",
}

filegroup {
    name: "local_apns_conf",
    srcs: ["*.xml"],
}

prebuilt_etc_xml {
    name: "apns-conf.xml",
    product_specific: true,
    src: ":apns-conf",
    schema: ":apns-conf-schema",
}

filegroup {
    name: "apns-conf-schema",
    srcs: ["apns-conf.xsd"],
}

python_binary_host {
    name: "make-apns",
    main: "make-apns.py",
    srcs: ["make-apns.py"],
    libs: ["pyyaml"],
}
